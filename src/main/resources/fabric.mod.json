{
	"schemaVersion": 1,
	"id": "crazy-world-progression",
	"version": "${version}",
	"name": "Crazy World Progression",
	"description": "A modular RPG and MMO framework for servers and content mods: skill trees and skill levels, item quality and crafting, portals with instanced dungeons and raids, parties, clans, custom mobs with scripted encounters, currencies, storage and more. Every part can be switched off in config/crazy-world-progression.yml.",
	"authors": [
		"Leon Hosch"
	],
	"contact": {
		"homepage": "https://github.com/LeonHosch/CrazyWorldProgression",
		"sources": "https://github.com/LeonHosch/CrazyWorldProgression",
		"issues": "https://github.com/LeonHosch/CrazyWorldProgression/issues"
	},
	"license": "AGPL-3.0-only",
	"icon": "assets/crazy-world-progression/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"ekuzo.crazyworldprogression.CrazyWorldProgression"
		],
		"client": [
			"ekuzo.crazyworldprogression.client.CrazyWorldProgressionClient"
		],
		"voicechat": [
			"ekuzo.crazyworldprogression.portals.PartyVoiceChatPlugin"
		],
		"journeymap": [
			"ekuzo.crazyworldprogression.client.map.JourneyMapIntegration"
		]
	},
	"mixins": [
		"crazy-world-progression.mixins.json",
		"mobforge.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"voicechat": ">=2.6.0",
		"journeymap": "*"
	}
}
